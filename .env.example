# --- Database ---------------------------------------------------------------
HOSANA_DB_PRISMA_DATABASE_URL=""
HOSANA_DB_POSTGRES_URL=""

# --- Server -------------------------------------------------------------
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# --- Auth -----------------------------------------------------------------
# Generate strong random secrets, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# --- Musician tokens --------------------------------------------------------
# Default validity applied when an admin does not supply expiresAt
MUSICIAN_TOKEN_DEFAULT_DAYS=365
# Public base URL used to build the QR code payload for musician tokens
PUBLIC_APP_URL=http://localhost:5173

# --- Seed / bootstrap admin --------------------------------------------
SEED_ADMIN_EMAIL=leader@church.org
SEED_ADMIN_PASSWORD=change_me_immediately
SEED_ADMIN_NAME=Worship Director
