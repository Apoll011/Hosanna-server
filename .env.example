# --- Database (Supabase) ---------------------------------------------------
# Connection pooler URL (for general app use via PgBouncer on port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URL (for migrations, on port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# --- Server ------------------------------------------------------------------
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173
# Optional. Defaults to 5 on Vercel, 20 elsewhere. Keep low when many
# Fluid isolates share a Postgres / PgBouncer connection budget.
# DB_POOL_MAX=5

# --- Auth --------------------------------------------------------------------
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
# Optional: Better Auth session token for local MCP stdio (`npm run mcp`)
# HOSANNA_BEARER_TOKEN=

# --- Studio AI (BYOK) --------------------------------------------------------
# 32-byte key as 64 hex chars. Used to encrypt org LLM API keys at rest.
# AI_SETTINGS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Metadata search (optional, Studio AI / MCP) -----------------------------
# YouTube Data API v3 — used to populate ChordPro {youtube: ...} directives.
# Without this key, web search (DeepSeek Search if org AI is DeepSeek, else
# DuckDuckGo) is used as a fallback.
# Put the key in THIS file (Hosanna-server/.env — not the dashboard) and restart
# the API process so it reloads env. In Google Cloud: enable "YouTube Data API
# v3"; if the key is IP-restricted, allow this machine's IP (not the browser).
# YOUTUBE_API_KEY=

# --- Public URL --------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:5173
STUDIO_URL=https://studio.hosanna.live
# MCP OAuth resource identifier (must match the public /mcp URL clients use)
# MCP_RESOURCE_URL=http://127.0.0.1:3000/mcp

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=re_123456789
EMAIL_FROM="Hosanna <no-reply@hosanna.live>"

# --- Firebase Cloud Messaging / Firestore ------------------------------------
# From Firebase console → Project settings → Service accounts → Generate key
# Used for FCM push, Firestore note pings (services/{id}/realtime/notes), and
# worship-service song annotations (services/{id}/annotations/{songId}).
# Enable Cloud Firestore and deploy firestore.rules (see firebase.json).
# Firebase Storage is NOT required for annotations.
FCM_PROJECT_ID="your-firebase-project-id"
FCM_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# Keep the literal \n escapes from the JSON key file:
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"

# --- Cron --------------------------------------------------------------------
# Shared secret required as `Authorization: Bearer <CRON_SECRET>` by /api/cron/*
CRON_SECRET="replace_with_a_long_random_secret"
