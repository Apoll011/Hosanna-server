# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Security
# Required in production. In development a random token is generated and
# printed to the console if this is left unset.
SYNC_API_TOKEN=

# Comma-separated list of allowed CORS origins. Use "*" to allow all
# (not recommended for production).
CORS_ORIGINS=*

# Storage
DATA_DIR=./data

# Limits
MAX_BODY_SIZE=50mb
MAX_SONG_SIZE_BYTES=2097152

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Optional static frontend (production only)
SERVE_STATIC=false
STATIC_DIR=./client/dist

# HTTPS
HTTPS_ENABLED=false
# Path to SSL certificate and key files
# SSL_KEY_FILE=./certs/server.key
# SSL_CRT_FILE=./certs/server.crt

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
