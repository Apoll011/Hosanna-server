{
  "name": "@hosanna/backend",
  "version": "2.19.2",
  "license": "Apache-2.0",
  "description": "Production REST API backend for Hosanna Studio (songs, folders, services, musician access)",
  "main": "dist/index.mjs",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:mcp-docs",
    "build:mcp-docs": "mkdir -p dist/mcp/docs && cp -R docs/mcp/. dist/mcp/docs/",
    "start": "node dist/index.mjs",
    "dev": "tsx watch src/index.mts",
    "mcp": "tsx src/mcp/stdio.ts",
    "test:mcp": "tsx --test src/mcp/lib/diff.test.ts src/mcp/lib/propagateChords.test.ts src/mcp/tools/chordpro.test.ts src/lib/aiCrypto.test.ts src/lib/oauthNavigationRedirect.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:push": "prisma db push",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/google": "^4.0.108",
    "@ai-sdk/openai": "^4.0.105",
    "@better-auth/i18n": "^1.7.14",
    "@better-auth/infra": "^0.4.5",
    "@better-auth/mcp": "^1.7.14",
    "@better-auth/stripe": "^1.7.14",
    "@hosanna/chordpro": "^1.6.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.*",
    "@supabase/supabase-js": "^2.49.0",
    "@vercel/functions": "^3.9.9",
    "ai": "^7.0.157",
    "better-auth": "^1.7.14",
    "better-inbox": "^0.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "handlebars": "^4.7.9",
    "helmet": "^7.1.0",
    "jose": "^6.2.14",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "resend": "^6.22.0",
    "stripe": "^22.6.1",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/handlebars": "^4.0.40",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.8",
    "prisma": "^7.*",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "better-call": "1.4.4"
  }
}
