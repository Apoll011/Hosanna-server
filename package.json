{
  "name": "@hosanna/backend",
  "version": "2.16.3",
  "license": "Apache-2.0",
  "description": "Production REST API backend for Hosanna Studio (songs, folders, services, musician access)",
  "main": "dist/index.mjs",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.mjs",
    "dev": "tsx watch src/index.mts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:push": "prisma db push",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/i18n": "^1.7.2",
    "@better-auth/infra": "^0.4.5",
    "@better-auth/stripe": "^1.7.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.*",
    "@supabase/supabase-js": "^2.49.0",
    "@types/compression": "^1.8.1",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.2",
    "better-inbox": "^0.1.2",
    "chordsheetjs": "^15.6.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "handlebars": "^4.7.9",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "resend": "^6.22.0",
    "stripe": "^22.6.1",
    "uuid": "^11.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/handlebars": "^4.0.40",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.8",
    "prisma": "^7.*",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
