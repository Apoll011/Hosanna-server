generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Admin (dashboard) users — JWT authentication
// ---------------------------------------------------------------------------
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("admins")
}

// Refresh tokens are stored hashed so they can be individually revoked
// (logout, rotation, "log out everywhere") instead of relying purely on
// a stateless JWT that cannot be invalidated before it expires.
model RefreshToken {
  id        String    @id @default(uuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Folders
// ---------------------------------------------------------------------------
model Folder {
  id        String   @id @default(uuid())
  name      String
  // Self-relation for nested folders. NULL = top level folder.
  // NOTE: the application-level "root" (folderId === null on a Song) is an
  // *implicit* concept and never materialized as a Folder row.
  parentId  String?
  parent    Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[] @relation("FolderChildren")
  songs     Song[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("folders")
}

// ---------------------------------------------------------------------------
// Songs
// ---------------------------------------------------------------------------
model Song {
  id        String   @id @default(uuid())
  title     String
  artist    String   @default("Unknown Artist")
  // Raw ChordPro source, stored directly in Postgres.
  content   String   @db.Text
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  path      String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceSongs ServiceSong[]

  @@index([folderId])
  @@index([title])
  @@map("songs")
}

// ---------------------------------------------------------------------------
// Services (worship services / setlists)
// ---------------------------------------------------------------------------
model Service {
  id        String   @id @default(uuid())
  name      String
  // Kept as a plain string (e.g. "2026-07-26") to stay wire-compatible with
  // the reference implementation, which never treats it as a real Date.
  date      String
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs         ServiceSong[]
  allowedTokens MusicianTokenService[]

  @@map("services")
}

// Join table between Service <-> Song that also carries per-song notes and
// ordering, replacing the old { songIds: string[], songNotes: {} } shape
// with a normalized structure while the API layer still serializes it back
// into the legacy shape for backward compatibility.
model ServiceSong {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  position  Int
  notes     String?  @db.Text
  updatedAt DateTime @updatedAt

  @@unique([serviceId, songId])
  @@index([serviceId, position])
  @@map("service_songs")
}

// ---------------------------------------------------------------------------
// Musician access tokens (QR-code distributed)
// ---------------------------------------------------------------------------
model MusicianToken {
  id         String    @id @default(uuid())
  name       String
  // SHA-256 hex digest of the raw token. Lookups are O(1) equality checks;
  // the raw value is never persisted and is only returned once, at
  // creation/regeneration time, to the admin who can then re-share the QR.
  tokenHash  String    @unique
  // Last 4 characters of the raw token, kept only for display purposes
  // ("...a91f") so admins can recognize a token without exposing it.
  tokenPreview String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  allowedServices MusicianTokenService[]

  @@map("musician_tokens")
}

// Join table for the optional "allowedServices" scoping of a musician token.
// An empty set means "all services" (matches reference implementation,
// where allowedServices: [] effectively granted unrestricted access).
model MusicianTokenService {
  musicianTokenId String
  musicianToken   MusicianToken @relation(fields: [musicianTokenId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([musicianTokenId, serviceId])
  @@map("musician_token_services")
}

// ---------------------------------------------------------------------------
// Settings (singleton row)
// ---------------------------------------------------------------------------
model Settings {
  id                  String   @id @default("settings")
  serverName          String   @default("ChordPro Studio Server")
  defaultKey          String   @default("G")
  syncIntervalSeconds Int      @default(30)
  allowPublicRead     Boolean  @default(false)
  autoBackupEnabled   Boolean  @default(true)
  maxUploadMB         Int      @default(10)
  updatedAt           DateTime @updatedAt

  @@map("settings")
}
