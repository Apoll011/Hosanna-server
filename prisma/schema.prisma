generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Folder {
  id String @id @default(uuid())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name  String
  color String @default("default")
  icon  String @default("default")

  parentId  String?
  parent    Folder?   @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]  @relation("FolderChildren")
  songs     Song[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   Boolean   @default(false) @map("_deleted")
  purgeAt   DateTime? @map("purge_at")

  @@index([orgId])
  @@index([parentId])
  @@index([orgId, updatedAt, id], map: "folders_replication_idx")
  @@map("folders")
}

model Song {
  id String @id @default(uuid())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title  String
  artist String @default("Unknown Artist")

  content                String                  @db.Text
  folderId               String?
  folder                 Folder?                 @relation(fields: [folderId], references: [id], onDelete: SetNull)
  path                   String
  tags                   String[]                @default([])
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  song_number            Int?
  deleted                Boolean                 @default(false) @map("_deleted")
  purgeAt                DateTime?               @map("purge_at")
  serviceSongAnnotations ServiceSongAnnotation[]

  @@unique([orgId, path])
  @@index([orgId])
  @@index([folderId])
  @@index([orgId, updatedAt, id], map: "songs_replication_idx")
  @@map("songs")
}

model ServiceSongAnnotation {
  id String @id @default(uuid())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  canvasData Bytes

  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, songId])
  @@index([orgId])
  @@index([serviceId])
  @@index([songId])
  @@index([orgId, updatedAt, id], map: "service_song_annotations_replication_idx")
  @@map("service_song_annotations")
}

model AgendaEvent {
  id String @id @default(uuid())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  date            String
  /**
   * Event title, e.g. "Culto Dominical".
   */
  title           String
  /**
   * Free-text event type, e.g. "Culto Dominical", "Ensaio de Louvor".
   */
  type            String
  /**
   * 24h time, "HH:mm".
   */
  time            String
  durationMinutes Int
  location        String?
  notes           String? @db.Text

  /**
   * `ReminderSettings` JSON: { enabled: boolean; label: string }.
   */
  reminder Json @default("{\"enabled\":false,\"label\":\"\"}")

  linkedServiceId String?
  linkedService   Service? @relation(fields: [linkedServiceId], references: [id], onDelete: SetNull)

  responsibilities Json @default("[]")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   Boolean   @default(false) @map("_deleted")
  purgeAt   DateTime? @map("purge_at")

  @@index([orgId])
  @@index([orgId, updatedAt, id], map: "agenda_events_replication_idx")
  @@map("agenda_events")
}

model Service {
  id String @id @default(uuid())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name String

  date      DateTime @default(now())
  notes     String?  @db.Text
  elements  Json?    @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  archived               Boolean                 @default(false)
  deleted                Boolean                 @default(false) @map("_deleted")
  purgeAt                DateTime?               @map("purge_at")
  serviceSongAnnotations ServiceSongAnnotation[]
  agendaEvents           AgendaEvent[]

  @@index([orgId])
  @@index([orgId, updatedAt, id], map: "services_replication_idx")
  @@map("services")
}

model User {
  id                     String                  @id
  name                   String
  email                  String
  emailVerified          Boolean                 @default(false)
  image                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  twoFactorEnabled       Boolean?                @default(false)
  sessions               Session[]
  accounts               Account[]
  notifications          Notification[]
  twofactors             TwoFactor[]
  teammembers            TeamMember[]
  members                Member[]
  invitations            Invitation[]
  serviceSongAnnotations ServiceSongAnnotation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  activeTeamId         String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Notification {
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  type           String
  title          String
  body           String?
  href           String?
  data           Json?
  read           Boolean  @default(false)
  createdAt      DateTime

  @@index([userId, createdAt], map: "notification_user_created_idx")
  @@map("notification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id                     String                  @id
  name                   String
  slug                   String
  logo                   String?
  createdAt              DateTime
  metadata               String?
  teams                  Team[]
  members                Member[]
  invitations            Invitation[]
  folders                Folder[]
  songs                  Song[]
  services               Service[]
  agendaEvents           AgendaEvent[]
  serviceSongAnnotations ServiceSongAnnotation[]

  @@unique([slug])
  @@map("organization")
}

model Team {
  id             String       @id
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?    @updatedAt
  teammembers    TeamMember[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id        String    @id
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime?

  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  teamId         String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
