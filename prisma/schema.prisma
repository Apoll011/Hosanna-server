generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  logo      String?
  active    Boolean  @default(true)
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins         Admin[]
  folders        Folder[]
  songs          Song[]
  services       Service[]
  musicianTokens MusicianToken[]
  settings       Settings?

  @@map("tenants")
}

model Admin {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String   @unique
  passwordHash String
  name         String
  logo         String?
  role         String   @default("admin")
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@map("admins")
}

model RefreshToken {
  id        String    @id @default(uuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@map("refresh_tokens")
}

model Folder {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String

  parentId  String?
  parent    Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[] @relation("FolderChildren")
  songs     Song[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([parentId])
  @@map("folders")
}

model Song {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title  String
  artist String @default("Unknown Artist")

  content     String   @db.Text
  folderId    String?
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  path        String
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  song_number Int?

  @@unique([tenantId, path])
  @@index([tenantId])
  @@index([folderId])
  @@index([tenantId, title])
  @@map("songs")
}

model Service {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String

  date      DateTime @default(now())
  notes     String?  @db.Text
  elements  Json?    @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  archived Boolean @default(false)

  allowedTokens MusicianTokenService[]

  @@index([tenantId])
  @@map("services")
}

model MusicianToken {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String

  tokenHash String @unique

  tokenPreview String
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  allowedServices MusicianTokenService[]

  @@index([tenantId])
  @@map("musician_tokens")
}

model MusicianTokenService {
  musicianTokenId String
  musicianToken   MusicianToken @relation(fields: [musicianTokenId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([musicianTokenId, serviceId])
  @@map("musician_token_services")
}

model Settings {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  serverName          String  @default("ChordPro Studio Server")
  defaultKey          String  @default("G")
  syncIntervalSeconds Int     @default(30)
  allowPublicRead     Boolean @default(false)
  autoBackupEnabled   Boolean @default(true)
  maxUploadMB         Int     @default(10)

  serviceTemplateId     String @default("service-default")
  serviceTemplateConfig Json   @default("{}")

  folderTemplateId     String @default("folder-default")
  folderTemplateConfig Json   @default("{}")

  songTemplateId     String @default("song-default")
  songTemplateConfig Json   @default("{}")

  updatedAt DateTime @updatedAt

  @@map("settings")
}
